# Copy this file to .env and enter values from your Supabase project.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase PostgreSQL - use the Session Pooler connection details.
# Find these in Supabase Dashboard > Project Settings > Database > Connection string.
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-database-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
